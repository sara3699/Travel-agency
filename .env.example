# Travel Agency App - environment template
# Created 2026-08-22. This file IS committed. It carries names only, never values.
# Copy it to .env and fill the real values there:  cp .env.example .env

# ---------------------------------------------------------------------------
# SUPABASE
# Dashboard > Project Settings > API
# ---------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=

# Project ref, the subdomain part of the URL, e.g. abcdefghijklm
SUPABASE_PROJECT_REF=

# --- Current API keys (sb_publishable_ / sb_secret_) ---

# Publishable key. Safe in the browser. Row Level Security is what protects the data.
SUPABASE_PUBLISHABLE_KEY=

# Secret key. SERVER ONLY. Bypasses Row Level Security completely.
# Never in client code, never behind a NEXT_PUBLIC_ or VITE_ prefix.
SUPABASE_SECRET_KEY=

# --- Legacy JWT keys, kept for libraries that still expect them ---

# Legacy anon key. Public by design, same role as the publishable key above.
SUPABASE_ANON_KEY=

# Legacy service role key. SERVER ONLY. Prefer SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection strings - Dashboard > Connect
# Pooled (6543) for the app, direct (5432) for migrations.
# Percent-encode any special characters in the password: @ becomes %40.
DATABASE_URL=
DIRECT_URL=

# Database password you set when the project was created
SUPABASE_DB_PASSWORD=

# JWT secret - Dashboard > Project Settings > API > JWT Settings
SUPABASE_JWT_SECRET=

# ---------------------------------------------------------------------------
# GITHUB
# ---------------------------------------------------------------------------

# Personal access token - github.com/settings/tokens
# Fine-grained token scoped to this repo is preferred over a classic one.
GITHUB_TOKEN=

# owner/repo
GITHUB_REPO=
GITHUB_REPO_URL=

# GitHub OAuth app - only needed if travellers sign in with GitHub via Supabase Auth
# github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# APP
# ---------------------------------------------------------------------------

# Base URL of the running app. Used for auth redirects and email links.
APP_URL=http://localhost:3000

NODE_ENV=development

# ---------------------------------------------------------------------------
# NOT YET DECIDED - uncomment when the provider is picked and written down
# in .memory/projects/ per CLAUDE.md
# ---------------------------------------------------------------------------

# Booking / inventory API
# BOOKING_API_KEY=
# BOOKING_API_SECRET=

# Payments
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# Maps
# MAPS_API_KEY=

# Transactional email
# EMAIL_API_KEY=
# EMAIL_FROM=
