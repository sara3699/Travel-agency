# Environment - real secrets, never committed
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Build output. Anchored with a leading slash so they match only at the repo
# root: an unanchored `build/` matches ANY directory of that name at any depth,
# which silently swallowed the whole app/[lang]/build/ route on 2026-08-28. It
# worked locally and would have 404'd in production, because the files were
# never in a commit.
/dist/
/build/
.next/
# A second build target, so a verification build does not fight a running dev
# server for `.next`. Two processes sharing it produce mismatched chunks that
# surface as `TypeError: a[d] is not a function` at runtime.
.next-verify/
out/

# Logs
*.log
npm-debug.log*
yarn-error.log*

# OS
.DS_Store

# Editor
.vscode/
.idea/

# Supabase CLI local state
.supabase/

# Memory vault - stays local. It accumulates client and traveller details,
# and CLAUDE.md rule 3 keeps those out of the repo.
# Delete these two lines if you decide the project pages should be versioned.
.memory/

# Claude Code local overrides - machine-specific paths, not shared
.claude/settings.local.json
.vercel

# TypeScript incremental build info
tsconfig.tsbuildinfo

# Supabase CLI scratch state. Machine-local, not source: it records which
# project this checkout is linked to and is rewritten by any CLI command.
supabase/.temp/
