# What NOT to upload to Vercel. When this file exists it replaces .gitignore as
# the upload filter, so everything .gitignore blocked has to be repeated here.

# Secrets - never leave the machine
.env
.env.*
!.env.example

# Local-only knowledge: memory vault, planning, internal docs, archives.
# The vault holds client and traveller detail (CLAUDE.md rule 5).
.memory/
.planning/
.impeccable/
.claude/
Archive/
docs/
*.csv
HANDOFF-BACKEND.md
PRODUCT.md
MEMORY.md
CLAUDE.md

# Installed and built fresh on Vercel
node_modules/
.next/
tsconfig.tsbuildinfo

# OS / editor
.DS_Store
.vscode/
.idea/
